{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "id": "calledElementBusinessId",
  "name": "Payment",
  "description": "Payment process call activity with business ID",
  "appliesTo": [
    "bpmn:Task",
    "bpmn:CallActivity"
  ],
  "elementType": {
    "value": "bpmn:CallActivity"
  },
  "properties":[
    {
      "type": "Hidden",
      "value": "paymentProcess",
      "binding": {
        "type": "zeebe:calledElement",
        "property": "processId"
      }
    },
    {
      "label": "Business ID",
      "type": "String",
      "feel": "optional",
      "value": "=order.customerId",
      "binding": {
        "type": "zeebe:calledElement",
        "property": "businessId"
      }
    }
  ]
}
