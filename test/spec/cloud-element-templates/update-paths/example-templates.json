            },
            "to": {
              "type": "zeebe:taskHeader",
              "key": "method"
            },
            "values": {
              "GET": "get",
              "POST": "post"
            }
          },
          {
            "from": {
              "type": "zeebe:input",
              "name": "requestBody"
            },
            "to": {
              "type": "zeebe:input",
              "name": "body"
            }
          },
          {
            "from": {
              "type": "zeebe:input",
              "name": "apiKey"
            },
            "to": {
              "type": "zeebe:input",
              "name": "authentication.type"
            },
            "values": {
              "*": "apiKey"
            }
          }
        ]
      }
    ]
  },
