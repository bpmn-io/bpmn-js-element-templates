        "choices": [
          {
            "name": "GET",
            "value": "GET"
          },
          {
            "name": "POST",
            "value": "POST"
          }
        ],
        "binding": {
          "type": "zeebe:taskHeader",
          "key": "method"
        }
      },
      {
        "label": "Timeout",
        "type": "String",
        "value": "PT30S",
        "binding": {
          "type": "zeebe:input",
          "name": "timeout"
        }
      },
      {
        "label": "Payload",
        "type": "String",
        "optional": true,
        "binding": {
          "type": "zeebe:input",
          "name": "payload"
        }
      },
      {
        "label": "API key",
        "type": "String",
        "optional": true,
        "binding": {
          "type": "zeebe:input",
          "name": "apiKey"
        }
      }
    ]
  },
