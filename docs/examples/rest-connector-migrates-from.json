[
  {
    "id": "io.camunda.connectors.HttpJson.v1.bearerToken",
    "description": "Migrate the legacy Bearer Token REST connector to the current REST connector.",
    "changes": "- Selects Bearer token authentication and keeps the configured token.\n- Converts legacy HTTP method values to uppercase.\n- Keeps the configured result expression, or leaves it unset if no expression was configured.",
    "properties": [
      {
        "to": { "type": "zeebe:input", "name": "authentication.type" },
        "set": "bearer"
      },
      {
        "from": { "type": "zeebe:input", "name": "authentication.token" },
        "to": { "type": "zeebe:input", "name": "authentication.token" }
      },
      {
        "from": { "type": "zeebe:input", "name": "method" },
        "to": { "type": "zeebe:input", "name": "method" },
        "values": {
          "get": "GET",
          "post": "POST",
          "patch": "PATCH",
          "put": "PUT",
          "delete": "DELETE"
        }
      },
      {
        "from": { "type": "zeebe:taskHeader", "key": "resultExpression" },
        "to": { "type": "zeebe:taskHeader", "key": "resultExpression" },
        "copyEmpty": true
      }
    ]
  }
]
